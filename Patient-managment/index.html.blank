<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="description" content="Healthcare Patient Management System - Complete medical record management solution">
    <meta name="theme-color" content="#667eea">
    <title>SAYDOC Healthcare HMS</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js for Charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- Main Stylesheet -->
    <link rel="stylesheet" href="src/PatientStyle/root.css">
    <link rel="stylesheet" href="src/PatientStyle/dashboard.css">
    <link rel="stylesheet" href="src/PatientStyle/patients.css">
    <link rel="stylesheet" href="src/PatientStyle/patientRegister.css">
    <link rel="stylesheet" href="src/PatientStyle/patientSearch.css">
    <link rel="stylesheet" href="src/PatientStyle/patientDetail.css">
    <link rel="stylesheet" href="src/PatientStyle/patientEdit.css">

</head>
<body>
    <div class="app-container">
        <!-- Mobile Menu Toggle Button -->
        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
            <i class="fas fa-bars"></i>
        </button>
        
        <!-- Sidebar Navigation -->
        <nav class="sidebar" id="sidebar">
            <div class="logo">
                <h2>
                    <i class="fas fa-hospital-user"></i> 
                    SAYDOC PMS
                </h2>
                <p>Healthcare Management System</p>
            </div>
            
            <ul class="nav-menu">
                <li data-page="dashboard" class="active">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </li>
                <li data-page="patients">
                    <i class="fas fa-users"></i>
                    <span>All Patients</span>
                </li>
                <li data-page="register">
                    <i class="fas fa-user-plus"></i>
                    <span>Register Patient</span>
                </li>
                <li data-page="search">
                    <i class="fas fa-search"></i>
                    <span>Advanced Search</span>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <div class="version">
                    <i class="fas fa-code-branch"></i>
                    <span>Version 2.0.0</span>
                </div>
                <div class="copyright">
                    <small>© 2024 Healthcare HMS</small>
                </div>
            </div>
        </nav>
        
        <!-- Main Content Area -->
        <main class="main-content">
            <div id="content-area">
                <!-- Dynamic content will be loaded here -->
                <div class="loading-container">
                    <div class="loading-spinner"></div>
                    <p>Loading Patient Management System...</p>
                </div>
            </div>
        </main>
    </div>
    
    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>
    
    <!-- Main Application Script -->
    <script src="src/app.js" type="module"></script>
</body>
</html>