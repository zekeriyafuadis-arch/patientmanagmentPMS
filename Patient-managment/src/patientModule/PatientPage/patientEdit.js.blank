export class PatientEdit {
    constructor(apiUrl, patientId) {
        this.apiUrl = apiUrl;
        this.patientId = patientId;
        this.patientData = null;
    }
    
    async render() {
        return `
            <div class="edit-container">
                <div class="edit-header">
                    <button class="btn-back" onclick="window.history.back()">← Back</button>
                    <h1>Edit Patient Information</h1>
                </div>
                
                <div id="editFormContainer">
                    <div class="loading">Loading patient data...</div>
                </div>
            </div>
        `;
    }
    
    async loadPatientData() {
        try {
            const response = await fetch(`${this.apiUrl}/${this.patientId}`);
            const data = await response.json();
            
            if (data.success && data.data) {
                this.patientData = data.data;
                this.displayEditForm();
            } else {
                document.getElementById('editFormContainer').innerHTML = '<div class="error">Patient not found</div>';
            }
        } catch (error) {
            console.error('Error loading patient:', error);
            document.getElementById('editFormContainer').innerHTML = '<div class="error">Error loading patient data</div>';
        }
    }
    
    displayEditForm() {
        const patient = this.patientData;
        const formHtml = `
            <form id="editPatientForm" class="patient-form">
                <div class="form-section">
                    <h3>Personal Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>MRN Number *</label>
                            <input type="text" value="${patient.mrn}" disabled>
                            <small class="info-text">MRN cannot be edited</small>
                        </div>
                        <div class="form-group">
                            <label>Registration Date *</label>
                            <input type="text" value="${new Date(patient.registration_date).toLocaleDateString()}" disabled>
                            <small class="info-text">Registration date cannot be edited</small>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Full Name *</label>
                            <input type="text" id="name" value="${this.escapeHtml(patient.name)}" required>
                        </div>
                        <div class="form-group">
                            <label>Father's Name *</label>
                            <input type="text" id="father_name" value="${this.escapeHtml(patient.father_name)}" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Grandfather's Name *</label>
                            <input type="text" id="grandfather_name" value="${this.escapeHtml(patient.grandfather_name)}" required>
                        </div>
                        <div class="form-group">
                            <label>Gender *</label>
                            <select id="gender" required>
                                <option value="Male" ${patient.gender === 'Male' ? 'selected' : ''}>Male</option>
                                <option value="Female" ${patient.gender === 'Female' ? 'selected' : ''}>Female</option>
                                <option value="Other" ${patient.gender === 'Other' ? 'selected' : ''}>Other</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Date of Birth *</label>
                            <input type="date" id="dob" value="${patient.dob}" required>
                        </div>
                        <div class="form-group">
                            <label>Age *</label>
                            <input type="number" id="age" value="${patient.age}" required>
                        </div>
                    </div>
                </div>
                
                <div class="form-section">
                    <h3>Address Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Address *</label>
                            <input type="text" id="address" value="${this.escapeHtml(patient.address)}" required>
                        </div>
                        <div class="form-group">
                            <label>Region *</label>
                            <input type="text" id="region" value="${this.escapeHtml(patient.region)}" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Wereda/Subcity *</label>
                            <input type="text" id="wereda_subcity" value="${this.escapeHtml(patient.wereda_subcity)}" required>
                        </div>
                        <div class="form-group">
                            <label>Ketena/Gott *</label>
                            <input type="text" id="ketena_gott" value="${this.escapeHtml(patient.ketena_gott)}" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Kebele *</label>
                            <input type="text" id="kebele" value="${this.escapeHtml(patient.kebele)}" required>
                        </div>
                        <div class="form-group">
                            <label>House Number</label>
                            <input type="text" id="house_number" value="${this.escapeHtml(patient.house_number || '')}">
                        </div>
                    </div>
                </div>
                
                <div class="form-section">
                    <h3>Contact Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Phone Number *</label>
                            <input type="tel" id="phone_number" value="${patient.phone_number}" required>
                        </div>
                        <div class="form-group">
                            <label>Emergency Contact Name *</label>
                            <input type="text" id="emergency_name" value="${this.escapeHtml(patient.emergency_name)}" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Emergency Contact Number *</label>
                            <input type="tel" id="emergency_number" value="${patient.emergency_number}" required>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn-update">💾 Update Patient</button>
                    <button type="button" class="btn-cancel" onclick="window.history.back()">❌ Cancel</button>
                </div>
            </form>
        `;
        
        document.getElementById('editFormContainer').innerHTML = formHtml;
        this.setupFormEvents();
    }
    
    setupFormEvents() {
        const form = document.getElementById('editPatientForm');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            await this.updatePatient();
        });
        
        // Auto-calculate age from DOB
        const dobInput = document.getElementById('dob');
        dobInput.addEventListener('change', () => {
            const dob = new Date(dobInput.value);
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            document.getElementById('age').value = age;
        });
    }
    
    async updatePatient() {
        const formData = {
            name: document.getElementById('name').value,
            father_name: document.getElementById('father_name').value,
            grandfather_name: document.getElementById('grandfather_name').value,
            gender: document.getElementById('gender').value,
            dob: document.getElementById('dob').value,
            age: parseInt(document.getElementById('age').value),
            address: document.getElementById('address').value,
            region: document.getElementById('region').value,
            wereda_subcity: document.getElementById('wereda_subcity').value,
            ketena_gott: document.getElementById('ketena_gott').value,
            kebele: document.getElementById('kebele').value,
            house_number: document.getElementById('house_number').value,
            phone_number: document.getElementById('phone_number').value,
            emergency_name: document.getElementById('emergency_name').value,
            emergency_number: document.getElementById('emergency_number').value
        };
        
        // Validation
        for (let [key, value] of Object.entries(formData)) {
            if (key !== 'house_number' && !value) {
                alert(`Please fill in ${key.replace('_', ' ')}`);
                return;
            }
        }
        
        try {
            const response = await fetch(`${this.apiUrl}/${this.patientId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            
            const data = await response.json();
            if (data.success) {
                alert('Patient information updated successfully!');
                window.location.hash = `patient/${this.patientId}`;
            } else {
                alert('Error: ' + (data.error || 'Could not update patient'));
            }
        } catch (error) {
            console.error('Error updating patient:', error);
            alert('Error updating patient information');
        }
    }
    
    escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
}