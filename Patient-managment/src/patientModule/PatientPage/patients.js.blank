export class Patients {
    constructor(apiUrl) {
        this.apiUrl = apiUrl;
    }
    
    async render() {
        return `
            <div class="patients-container">
                <div class="patients-header">
                    <h1>All Patients</h1>
                    <div class="export-buttons">
                        <button class="btn-export-csv" id="exportCSV">📊 Export CSV</button>
                        <button class="btn-export-excel" id="exportExcel">📈 Export Excel</button>
                        <button class="btn-export-pdf" id="exportPDF">📄 Export PDF</button>
                        <button class="btn-print-all" id="printAll">🖨️ Print All</button>
                    </div>
                </div>
                <div class="patients-table-container">
                    <table class="patients-table">
                        <thead>
                            <tr>
                                <th>MRN</th>
                                <th>Name</th>
                                <th>Father's Name</th>
                                <th>Gender</th>
                                <th>Age</th>
                                <th>Phone</th>
                                <th>Region</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="patientsTableBody">
                            <tr><td colspan="8">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        `;
    }
    
    async loadPatients() {
        try {
            const response = await fetch(`${this.apiUrl}`);
            const data = await response.json();
            
            if (data.success && data.data) {
                const tbody = document.getElementById('patientsTableBody');
                tbody.innerHTML = data.data.map(patient => `
                    <tr>
                        <td>${patient.mrn}</td>
                        <td>${patient.name}</td>
                        <td>${patient.father_name}</td>
                        <td>${patient.gender}</td>
                        <td>${patient.age}</td>
                        <td>${patient.phone_number}</td>
                        <td>${patient.region}</td>
                        <td>
                            <button class="btn-view" data-id="${patient.id}">View</button>
                            <button class="btn-edit" data-id="${patient.id}">Edit</button>
                            <button class="btn-delete" data-id="${patient.id}">Delete</button>
                            <button class="btn-pdf-single" data-id="${patient.id}">PDF</button>
                        </td>
                    </tr>
                `).join('');
                
                this.attachEventListeners();
                this.attachExportListeners();
            }
        } catch (error) {
            console.error('Error loading patients:', error);
        }
    }
    
    attachEventListeners() {
        document.querySelectorAll('.btn-view').forEach(btn => {
            btn.addEventListener('click', () => this.viewPatient(btn.dataset.id));
        });
        
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', () => this.editPatient(btn.dataset.id));
        });
        
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => this.deletePatient(btn.dataset.id));
        });
        
        document.querySelectorAll('.btn-pdf-single').forEach(btn => {
            btn.addEventListener('click', () => this.downloadSinglePDF(btn.dataset.id));
        });
    }
    
    attachExportListeners() {
        const exportCSV = document.getElementById('exportCSV');
        const exportExcel = document.getElementById('exportExcel');
        const exportPDF = document.getElementById('exportPDF');
        const printAll = document.getElementById('printAll');
        
        if (exportCSV) exportCSV.addEventListener('click', () => this.exportToCSV());
        if (exportExcel) exportExcel.addEventListener('click', () => this.exportToExcel());
        if (exportPDF) exportPDF.addEventListener('click', () => this.exportToPDF());
        if (printAll) printAll.addEventListener('click', () => this.printAllPatients());
    }
    
    async viewPatient(id) {
        // Navigate to detail page
        const contentArea = document.getElementById('content-area');
        const { PatientDetail } = await import('./patientDetail.js');
        const detailPage = new PatientDetail(this.apiUrl, id);
        contentArea.innerHTML = await detailPage.render();
        await detailPage.loadPatientDetails();
    }
    
    async editPatient(id) {
    // Load edit form
    const contentArea = document.getElementById('content-area');
    const { PatientEdit } = await import('./patientEdit.js');
    const editPage = new PatientEdit(this.apiUrl, id);
    contentArea.innerHTML = await editPage.render();
    await editPage.loadPatientData();
}
    
    async deletePatient(id) {
        if (confirm('Are you sure you want to delete this patient?')) {
            try {
                const response = await fetch(`${this.apiUrl}/${id}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) {
                    alert('Patient deleted successfully');
                    this.loadPatients();
                }
            } catch (error) {
                console.error('Error deleting patient:', error);
                alert('Error deleting patient');
            }
        }
    }
    
    downloadSinglePDF(id) {
        window.open(`${this.apiUrl}/export/pdf/${id}`, '_blank');
    }
    
    exportToCSV() {
        window.open(`${this.apiUrl}/export/csv`, '_blank');
    }
    
    exportToExcel() {
        window.open(`${this.apiUrl}/export/excel`, '_blank');
    }
    
    exportToPDF() {
        window.open(`${this.apiUrl}/export/pdf/all`, '_blank');
    }
    
    async printAllPatients() {
        try {
            const response = await fetch(`${this.apiUrl}`);
            const data = await response.json();
            
            if (data.success && data.data) {
                this.generatePrintWindow(data.data);
            }
        } catch (error) {
            console.error('Error printing patients:', error);
            alert('Error printing patients list');
        }
    }
    
    generatePrintWindow(patients) {
        const printWindow = window.open('', '_blank');
        printWindow.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
                <title>All Patients List</title>
                <style>
                    body {
                        font-family: Arial, sans-serif;
                        padding: 20px;
                    }
                    .header {
                        text-align: center;
                        margin-bottom: 30px;
                        border-bottom: 2px solid #667eea;
                        padding-bottom: 20px;
                    }
                    .header h1 {
                        color: #667eea;
                        margin: 0;
                    }
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                    }
                    th, td {
                        border: 1px solid #ddd;
                        padding: 10px;
                        text-align: left;
                    }
                    th {
                        background-color: #667eea;
                        color: white;
                    }
                    tr:nth-child(even) {
                        background-color: #f9f9f9;
                    }
                    .footer {
                        margin-top: 30px;
                        text-align: center;
                        font-size: 12px;
                        color: #999;
                    }
                    @media print {
                        body {
                            padding: 10px;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="header">
                    <h1>Patient Management System</h1>
                    <p>All Patients Report</p>
                    <p>Generated: ${new Date().toLocaleString()}</p>
                    <p>Total Patients: ${patients.length}</p>
                </div>
                
                <table>
                    <thead>
                        <tr>
                            <th>MRN</th>
                            <th>Name</th>
                            <th>Father's Name</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Phone</th>
                            <th>Region</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${patients.map(patient => `
                            <tr>
                                <td>${patient.mrn}</td>
                                <td>${patient.name}</td>
                                <td>${patient.father_name}</td>
                                <td>${patient.gender}</td>
                                <td>${patient.age}</td>
                                <td>${patient.phone_number}</td>
                                <td>${patient.region}</td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>
                
                <div class="footer">
                    <p>This is a computer generated document. No signature required.</p>
                    <p>Patient Management System - Official Medical Record</p>
                </div>
            </body>
            </html>
        `);
        printWindow.document.close();
        printWindow.print();
    }
}