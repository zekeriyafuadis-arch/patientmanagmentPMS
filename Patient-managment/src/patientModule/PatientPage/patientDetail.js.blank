export class PatientDetail {
    constructor(apiUrl, patientId) {
        this.apiUrl = apiUrl;
        this.patientId = patientId;
    }
    
    async render() {
        return `
            <div class="detail-container">
                <div class="detail-header">
                    <button class="btn-back" onclick="window.history.back()">← Back</button>
                    <h1>Patient Details</h1>
                    <div class="action-buttons">
                        <button class="btn-print" id="printBtn">🖨️ Print</button>
                        <button class="btn-pdf" id="pdfBtn">📄 Download PDF</button>
                    </div>
                </div>
                <div id="patientDetailContent" class="patient-detail-content">
                    <div class="loading">Loading patient details...</div>
                </div>
            </div>
        `;
    }
    
    async loadPatientDetails() {
        try {
            const response = await fetch(`${this.apiUrl}/${this.patientId}`);
            const data = await response.json();
            
            if (data.success && data.data) {
                this.displayPatientDetails(data.data);
                this.setupEventListeners(data.data);
            } else {
                document.getElementById('patientDetailContent').innerHTML = '<div class="error">Patient not found</div>';
            }
        } catch (error) {
            console.error('Error loading patient details:', error);
            document.getElementById('patientDetailContent').innerHTML = '<div class="error">Error loading patient details</div>';
        }
    }
    
    displayPatientDetails(patient) {
        const html = `
            <div class="detail-card">
                <div class="detail-section">
                    <h2>Personal Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>MRN Number:</label>
                            <span class="mrn-badge">${patient.mrn}</span>
                        </div>
                        <div class="detail-item">
                            <label>Registration Date:</label>
                            <span>${new Date(patient.registration_date).toLocaleDateString()}</span>
                        </div>
                        <div class="detail-item">
                            <label>Full Name:</label>
                            <span>${patient.name}</span>
                        </div>
                        <div class="detail-item">
                            <label>Father's Name:</label>
                            <span>${patient.father_name}</span>
                        </div>
                        <div class="detail-item">
                            <label>Grandfather's Name:</label>
                            <span>${patient.grandfather_name}</span>
                        </div>
                        <div class="detail-item">
                            <label>Gender:</label>
                            <span>${patient.gender}</span>
                        </div>
                        <div class="detail-item">
                            <label>Date of Birth:</label>
                            <span>${patient.dob}</span>
                        </div>
                        <div class="detail-item">
                            <label>Age:</label>
                            <span>${patient.age} years</span>
                        </div>
                    </div>
                </div>
                
                <div class="detail-section">
                    <h2>Address Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>Address:</label>
                            <span>${patient.address}</span>
                        </div>
                        <div class="detail-item">
                            <label>Region:</label>
                            <span>${patient.region}</span>
                        </div>
                        <div class="detail-item">
                            <label>Wereda/Subcity:</label>
                            <span>${patient.wereda_subcity}</span>
                        </div>
                        <div class="detail-item">
                            <label>Ketena/Gott:</label>
                            <span>${patient.ketena_gott}</span>
                        </div>
                        <div class="detail-item">
                            <label>Kebele:</label>
                            <span>${patient.kebele}</span>
                        </div>
                        <div class="detail-item">
                            <label>House Number:</label>
                            <span>${patient.house_number || 'N/A'}</span>
                        </div>
                    </div>
                </div>
                
                <div class="detail-section">
                    <h2>Contact Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>Phone Number:</label>
                            <span>${patient.phone_number}</span>
                        </div>
                        <div class="detail-item">
                            <label>Emergency Contact:</label>
                            <span>${patient.emergency_name}</span>
                        </div>
                        <div class="detail-item">
                            <label>Emergency Number:</label>
                            <span>${patient.emergency_number}</span>
                        </div>
                    </div>
                </div>
                
                <div class="detail-section">
                    <h2>Additional Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <label>Created At:</label>
                            <span>${new Date(patient.created_at).toLocaleString()}</span>
                        </div>
                        <div class="detail-item">
                            <label>Last Updated:</label>
                            <span>${new Date(patient.updated_at).toLocaleString()}</span>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        document.getElementById('patientDetailContent').innerHTML = html;
    }
    
    setupEventListeners(patient) {
        const printBtn = document.getElementById('printBtn');
        const pdfBtn = document.getElementById('pdfBtn');
        
        if (printBtn) {
            printBtn.addEventListener('click', () => this.printPatientDetails(patient));
        }
        
        if (pdfBtn) {
            pdfBtn.addEventListener('click', () => this.downloadPDF(patient.id));
        }
    }
    
    printPatientDetails(patient) {
        const printWindow = window.open('', '_blank');
        printWindow.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
                <title>Patient Details - ${patient.name}</title>
                <style>
                    body {
                        font-family: Arial, sans-serif;
                        padding: 40px;
                        margin: 0;
                    }
                    .header {
                        text-align: center;
                        margin-bottom: 30px;
                        border-bottom: 2px solid #667eea;
                        padding-bottom: 20px;
                    }
                    .header h1 {
                        color: #667eea;
                        margin: 0;
                    }
                    .section {
                        margin-bottom: 25px;
                        page-break-inside: avoid;
                    }
                    .section h2 {
                        background: #667eea;
                        color: white;
                        padding: 10px;
                        margin: 0 0 15px 0;
                        font-size: 16px;
                    }
                    .detail-grid {
                        display: grid;
                        grid-template-columns: repeat(2, 1fr);
                        gap: 15px;
                    }
                    .detail-item {
                        padding: 8px;
                        border-bottom: 1px solid #eee;
                    }
                    .detail-item label {
                        font-weight: bold;
                        display: inline-block;
                        width: 150px;
                    }
                    .mrn-badge {
                        background: #667eea;
                        color: white;
                        padding: 3px 10px;
                        border-radius: 5px;
                        font-weight: bold;
                    }
                    .footer {
                        margin-top: 40px;
                        text-align: center;
                        font-size: 12px;
                        color: #999;
                        border-top: 1px solid #eee;
                        padding-top: 20px;
                    }
                    @media print {
                        body {
                            padding: 20px;
                        }
                        .no-print {
                            display: none;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="header">
                    <h1>Patient Management System</h1>
                    <p>Patient Detailed Report</p>
                    <p>Generated: ${new Date().toLocaleString()}</p>
                </div>
                
                <div class="section">
                    <h2>Personal Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item"><label>MRN:</label> ${patient.mrn}</div>
                        <div class="detail-item"><label>Registration Date:</label> ${new Date(patient.registration_date).toLocaleDateString()}</div>
                        <div class="detail-item"><label>Full Name:</label> ${patient.name}</div>
                        <div class="detail-item"><label>Father's Name:</label> ${patient.father_name}</div>
                        <div class="detail-item"><label>Grandfather's Name:</label> ${patient.grandfather_name}</div>
                        <div class="detail-item"><label>Gender:</label> ${patient.gender}</div>
                        <div class="detail-item"><label>Date of Birth:</label> ${patient.dob}</div>
                        <div class="detail-item"><label>Age:</label> ${patient.age} years</div>
                    </div>
                </div>
                
                <div class="section">
                    <h2>Address Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item"><label>Address:</label> ${patient.address}</div>
                        <div class="detail-item"><label>Region:</label> ${patient.region}</div>
                        <div class="detail-item"><label>Wereda/Subcity:</label> ${patient.wereda_subcity}</div>
                        <div class="detail-item"><label>Ketena/Gott:</label> ${patient.ketena_gott}</div>
                        <div class="detail-item"><label>Kebele:</label> ${patient.kebele}</div>
                        <div class="detail-item"><label>House Number:</label> ${patient.house_number || 'N/A'}</div>
                    </div>
                </div>
                
                <div class="section">
                    <h2>Contact Information</h2>
                    <div class="detail-grid">
                        <div class="detail-item"><label>Phone:</label> ${patient.phone_number}</div>
                        <div class="detail-item"><label>Emergency Contact:</label> ${patient.emergency_name}</div>
                        <div class="detail-item"><label>Emergency Number:</label> ${patient.emergency_number}</div>
                    </div>
                </div>
                
                <div class="footer">
                    <p>This is a computer generated document. No signature required.</p>
                    <p>Patient Management System - Official Medical Record</p>
                </div>
            </body>
            </html>
        `);
        printWindow.document.close();
        printWindow.print();
    }
    
    async downloadPDF(patientId) {
        try {
            window.open(`${this.apiUrl}/export/pdf/${patientId}`, '_blank');
        } catch (error) {
            console.error('Error downloading PDF:', error);
            alert('Error downloading PDF. Please try again.');
        }
    }
}