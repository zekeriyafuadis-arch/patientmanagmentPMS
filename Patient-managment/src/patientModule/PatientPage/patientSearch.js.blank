export class PatientSearch {
    constructor(apiUrl) {
        this.apiUrl = apiUrl;
        this.currentPage = 1;
        this.pageSize = 10;
        this.totalPatients = 0;
        this.searchResults = [];
    }
    
    render() {
        return `
            <div class="search-container">
                <h1>Advanced Patient Search</h1>
                
                <!-- Search Filters -->
                <div class="search-filters">
                    <div class="filter-group">
                        <input type="text" id="searchName" placeholder="Search by name...">
                        <input type="text" id="searchMRN" placeholder="MRN number...">
                        <input type="text" id="searchPhone" placeholder="Phone number...">
                    </div>
                    
                    <div class="filter-group">
                        <select id="searchGender">
                            <option value="">All Genders</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        
                        <select id="searchRegion">
                            <option value="">All Regions</option>
                            <option value="Addis Ababa">Addis Ababa</option>
                            <option value="Oromia">Oromia</option>
                            <option value="Amhara">Amhara</option>
                            <option value="Tigray">Tigray</option>
                            <option value="SNNPR">SNNPR</option>
                            <option value="Somali">Somali</option>
                            <option value="Harari">Harari</option>
                            <option value="Dire Dawa">Dire Dawa</option>
                        </select>
                        
                        <input type="number" id="minAge" placeholder="Min Age" style="width: 100px;">
                        <input type="number" id="maxAge" placeholder="Max Age" style="width: 100px;">
                    </div>
                    
                    <div class="filter-actions">
                        <button id="advancedSearchBtn" class="btn-search">🔍 Advanced Search</button>
                        <button id="resetFiltersBtn" class="btn-reset">🔄 Reset Filters</button>
                        <button id="exportResultsBtn" class="btn-export">📊 Export Results</button>
                    </div>
                </div>
                
                <!-- Quick Search -->
                <div class="quick-search">
                    <input type="text" id="quickSearchInput" placeholder="Quick search by name, MRN, phone, father's name, or region...">
                    <button id="quickSearchBtn">Quick Search</button>
                </div>
                
                <!-- Search Results -->
                <div id="searchStats" class="search-stats"></div>
                <div id="searchResults" class="search-results"></div>
                
                <!-- Pagination -->
                <div id="pagination" class="pagination"></div>
            </div>
        `;
    }
    
    initSearch() {
        // Quick search
        const quickSearchBtn = document.getElementById('quickSearchBtn');
        const quickSearchInput = document.getElementById('quickSearchInput');
        
        quickSearchBtn.addEventListener('click', () => this.quickSearch());
        quickSearchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') this.quickSearch();
        });
        
        // Advanced search
        const advancedSearchBtn = document.getElementById('advancedSearchBtn');
        advancedSearchBtn.addEventListener('click', () => this.advancedSearch());
        
        // Reset filters
        const resetBtn = document.getElementById('resetFiltersBtn');
        resetBtn.addEventListener('click', () => this.resetFilters());
        
        // Export results
        const exportBtn = document.getElementById('exportResultsBtn');
        exportBtn.addEventListener('click', () => this.exportResults());
        
        // Load initial data
        this.loadAllPatients();
    }
    
    async quickSearch() {
        const searchTerm = document.getElementById('quickSearchInput').value;
        if (!searchTerm.trim()) {
            this.loadAllPatients();
            return;
        }
        
        try {
            const response = await fetch(`${this.apiUrl}/search?q=${encodeURIComponent(searchTerm)}`);
            const data = await response.json();
            
            if (data.success) {
                this.searchResults = data.data;
                this.totalPatients = data.data.length;
                this.currentPage = 1;
                this.displayResults();
            }
        } catch (error) {
            console.error('Error during quick search:', error);
            this.showError('Error performing search');
        }
    }
    
    async advancedSearch() {
        const filters = {
            name: document.getElementById('searchName').value,
            mrn: document.getElementById('searchMRN').value,
            phone: document.getElementById('searchPhone').value,
            gender: document.getElementById('searchGender').value,
            region: document.getElementById('searchRegion').value,
            minAge: document.getElementById('minAge').value,
            maxAge: document.getElementById('maxAge').value
        };
        
        try {
            // First get all patients then filter client-side for advanced filters
            const response = await fetch(`${this.apiUrl}`);
            const data = await response.json();
            
            if (data.success) {
                let results = data.data;
                
                // Apply filters
                if (filters.name) {
                    results = results.filter(p => p.name.toLowerCase().includes(filters.name.toLowerCase()));
                }
                if (filters.mrn) {
                    results = results.filter(p => p.mrn.toLowerCase().includes(filters.mrn.toLowerCase()));
                }
                if (filters.phone) {
                    results = results.filter(p => p.phone_number.includes(filters.phone));
                }
                if (filters.gender) {
                    results = results.filter(p => p.gender === filters.gender);
                }
                if (filters.region) {
                    results = results.filter(p => p.region === filters.region);
                }
                if (filters.minAge) {
                    results = results.filter(p => p.age >= parseInt(filters.minAge));
                }
                if (filters.maxAge) {
                    results = results.filter(p => p.age <= parseInt(filters.maxAge));
                }
                
                this.searchResults = results;
                this.totalPatients = results.length;
                this.currentPage = 1;
                this.displayResults();
                
                // Show search stats
                this.showSearchStats(filters);
            }
        } catch (error) {
            console.error('Error during advanced search:', error);
            this.showError('Error performing advanced search');
        }
    }
    
    async loadAllPatients() {
        try {
            const response = await fetch(`${this.apiUrl}`);
            const data = await response.json();
            
            if (data.success) {
                this.searchResults = data.data;
                this.totalPatients = data.data.length;
                this.currentPage = 1;
                this.displayResults();
                document.getElementById('searchStats').innerHTML = `
                    <div class="stats-info">
                        <strong>Total Patients:</strong> ${this.totalPatients}
                    </div>
                `;
            }
        } catch (error) {
            console.error('Error loading patients:', error);
            this.showError('Error loading patients');
        }
    }
    
    displayResults() {
        const resultsDiv = document.getElementById('searchResults');
        const startIndex = (this.currentPage - 1) * this.pageSize;
        const endIndex = startIndex + this.pageSize;
        const pageResults = this.searchResults.slice(startIndex, endIndex);
        
        if (pageResults.length === 0) {
            resultsDiv.innerHTML = '<div class="no-results">No patients found matching your criteria</div>';
            document.getElementById('pagination').innerHTML = '';
            return;
        }
        
        resultsDiv.innerHTML = `
            <div class="results-header">
                <h3>Search Results</h3>
                <div class="results-count">Found ${this.totalPatients} patient(s)</div>
            </div>
            <div class="results-grid">
                ${pageResults.map(patient => `
                    <div class="result-card">
                        <div class="card-header">
                            <h4>${patient.name}</h4>
                            <span class="mrn-badge">${patient.mrn}</span>
                        </div>
                        <div class="card-body">
                            <p><strong>Name:</strong> ${patient.name}</p>
                            <p><strong> Father:</strong> ${patient.father_name}</p>
                            <p><strong> Grandfather:</strong> ${patient.grandfather_name}</p>
                            <p><strong>Gender:</strong> ${patient.gender}</p>
                            <p><strong> Age:</strong> ${patient.age} years</p>
                            <p><strong> Phone:</strong> ${patient.phone_number}</p>
                            <p><strong> Region:</strong> ${patient.region}</p>
                            <p><strong> Wereda:</strong> ${patient.wereda_subcity}</p>
                            <p><strong> Kebele:</strong> ${patient.kebele}</p>
                            <p><strong>Registered:</strong> ${new Date(patient.registration_date).toLocaleDateString()}</p>
                        </div>
                        <div class="card-actions">
                            <button class="view-details" data-id="${patient.id}">👁️ View Details</button>
                            <button class="edit-patient" data-id="${patient.id}">✏️ Edit</button>
                            <button class="download-pdf" data-id="${patient.id}">📄 PDF</button>
                            <button class="delete-patient" data-id="${patient.id}">🗑️ Delete</button>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;
        
        this.setupPagination();
        this.attachResultEventListeners();
    }
    
    setupPagination() {
        const totalPages = Math.ceil(this.totalPatients / this.pageSize);
        const paginationDiv = document.getElementById('pagination');
        
        if (totalPages <= 1) {
            paginationDiv.innerHTML = '';
            return;
        }
        
        let paginationHtml = '<div class="pagination-controls">';
        
        // Previous button
        paginationHtml += `<button class="page-btn" ${this.currentPage === 1 ? 'disabled' : ''} data-page="${this.currentPage - 1}">Previous</button>`;
        
        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= this.currentPage - 2 && i <= this.currentPage + 2)) {
                paginationHtml += `<button class="page-btn ${i === this.currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
            } else if (i === this.currentPage - 3 || i === this.currentPage + 3) {
                paginationHtml += '<span class="page-dots">...</span>';
            }
        }
        
        // Next button
        paginationHtml += `<button class="page-btn" ${this.currentPage === totalPages ? 'disabled' : ''} data-page="${this.currentPage + 1}">Next</button>`;
        paginationHtml += '</div>';
        
        paginationDiv.innerHTML = paginationHtml;
        
        // Add event listeners to pagination buttons
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const page = parseInt(btn.dataset.page);
                if (!isNaN(page) && page !== this.currentPage) {
                    this.currentPage = page;
                    this.displayResults();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        });
    }
    
    attachResultEventListeners() {
        // View details
        document.querySelectorAll('.view-details').forEach(btn => {
            btn.addEventListener('click', () => this.viewPatientDetails(btn.dataset.id));
        });
        
        // Edit patient
        document.querySelectorAll('.edit-patient').forEach(btn => {
            btn.addEventListener('click', () => this.editPatient(btn.dataset.id));
        });
        
        // Download PDF
        document.querySelectorAll('.download-pdf').forEach(btn => {
            btn.addEventListener('click', () => this.downloadPDF(btn.dataset.id));
        });
        
        // Delete patient
        document.querySelectorAll('.delete-patient').forEach(btn => {
            btn.addEventListener('click', () => this.deletePatient(btn.dataset.id));
        });
    }
    
    viewPatientDetails(id) {
        window.location.hash = `patient/${id}`;
    }
    
    async editPatient(id) {
        // Load edit form
        const contentArea = document.getElementById('content-area');
        const { PatientEdit } = await import('./patientEdit.js');
        const editPage = new PatientEdit(this.apiUrl, id);
        contentArea.innerHTML = await editPage.render();
        await editPage.loadPatientData();
    }
    
    downloadPDF(id) {
        window.open(`${this.apiUrl}/export/pdf/${id}`, '_blank');
    }
    
    async deletePatient(id) {
        if (confirm('Are you sure you want to delete this patient? This action cannot be undone.')) {
            try {
                const response = await fetch(`${this.apiUrl}/${id}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.success) {
                    alert('Patient deleted successfully');
                    this.loadAllPatients();
                } else {
                    alert('Error deleting patient');
                }
            } catch (error) {
                console.error('Error deleting patient:', error);
                alert('Error deleting patient');
            }
        }
    }
    
    resetFilters() {
        document.getElementById('searchName').value = '';
        document.getElementById('searchMRN').value = '';
        document.getElementById('searchPhone').value = '';
        document.getElementById('searchGender').value = '';
        document.getElementById('searchRegion').value = '';
        document.getElementById('minAge').value = '';
        document.getElementById('maxAge').value = '';
        document.getElementById('quickSearchInput').value = '';
        this.loadAllPatients();
    }
    
    showSearchStats(filters) {
        const activeFilters = Object.entries(filters).filter(([key, value]) => value && value !== '').length;
        document.getElementById('searchStats').innerHTML = `
            <div class="stats-info">
                <strong>Search Results:</strong> ${this.totalPatients} patient(s) found
                <span class="filter-badge">Active Filters: ${activeFilters}</span>
                <button class="clear-filters" id="clearFiltersBtn">Clear All Filters</button>
            </div>
        `;
        
        const clearBtn = document.getElementById('clearFiltersBtn');
        if (clearBtn) {
            clearBtn.addEventListener('click', () => this.resetFilters());
        }
    }
    
    async exportResults() {
        if (this.searchResults.length === 0) {
            alert('No results to export');
            return;
        }
        
        // Create CSV from current search results
        const headers = [
            'MRN', 'Registration Date', 'Full Name', 'Father\'s Name', 'Grandfather\'s Name',
            'Gender', 'Date of Birth', 'Age', 'Address', 'Region', 'Wereda/Subcity',
            'Ketena/Gott', 'Kebele', 'House Number', 'Phone Number', 'Emergency Contact',
            'Emergency Number'
        ];
        
        const csvRows = [];
        csvRows.push(headers.join(','));
        
        this.searchResults.forEach(patient => {
            const row = [
                `"${patient.mrn}"`,
                `"${new Date(patient.registration_date).toLocaleDateString()}"`,
                `"${patient.father_name}"`,
                `"${patient.name}"`,
                `"${patient.grandfather_name}"`,
                `"${patient.gender}"`,
                `"${patient.dob}"`,
                patient.age,
                `"${patient.address}"`,
                `"${patient.region}"`,
                `"${patient.wereda_subcity}"`,
                `"${patient.ketena_gott}"`,
                `"${patient.kebele}"`,
                `"${patient.house_number || ''}"`,
                `"${patient.phone_number}"`,
                `"${patient.emergency_name}"`,
                `"${patient.emergency_number}"`
            ];
            csvRows.push(row.join(','));
        });
        
        const csvContent = csvRows.join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `search_results_${Date.now()}.csv`;
        a.click();
        window.URL.revokeObjectURL(url);
        
        alert(`Exported ${this.searchResults.length} patient(s) to CSV`);
    }
    
    showError(message) {
        const resultsDiv = document.getElementById('searchResults');
        resultsDiv.innerHTML = `<div class="error-message">${message}</div>`;
    }
}