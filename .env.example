# =============================================================================

# Dr Amin Specialty Dental Clinic PMS — Environment Configuration

# =============================================================================

# Copy this file to `.env` in the project root and adjust values as needed.

# The server loads `.env` automatically on startup (via dotenv).

#

#   cp .env.example .env        # macOS / Linux

#   copy .env.example .env      # Windows

# =============================================================================



# -----------------------------------------------------------------------------

# Server

# -----------------------------------------------------------------------------

# HTTP port for the Express server (default: 3000)

PORT=3000

# Bind address — use 0.0.0.0 so phones/tablets on the same Wi‑Fi can connect

PMS_HOST=0.0.0.0



# Node environment: development | production | test
# Use production in the clinic: npm run start:prod
NODE_ENV=development



# -----------------------------------------------------------------------------

# Logging (Pino)

# -----------------------------------------------------------------------------

# Log level: trace | debug | info | warn | error | fatal

LOG_LEVEL=info



# -----------------------------------------------------------------------------

# Security

# -----------------------------------------------------------------------------

# Secret used to sign JWT auth tokens. CHANGE THIS in production.

# Use a long random string (32+ characters).

JWT_SECRET=change-me-in-production-use-long-random-string

# JWT session length (default: 24h in production, 7d in development)
# JWT_EXPIRES_IN=24h



# -----------------------------------------------------------------------------

# Rate limiting (per IP, sliding window)

# -----------------------------------------------------------------------------

# General API requests per 15 minutes (default: 300)

RATE_LIMIT_MAX=300



# Login attempts per 15 minutes (default: 10)

RATE_LIMIT_AUTH_MAX=10



# Database backup requests per hour (default: 5)

RATE_LIMIT_BACKUP_MAX=5



# Set to 1 to disable all rate limits (useful for local debugging only — never in production)
# PMS_DISABLE_RATE_LIMIT=0

# Extra browser origins allowed in production CORS (comma-separated full URLs)
# PMS_CORS_ORIGINS=https://clinic.example.com



# -----------------------------------------------------------------------------

# Data storage (optional overrides)

# -----------------------------------------------------------------------------

# Default data folder: ./patientsData/

# PMS_DATA_DIR=./patientsData

# PMS_DB_PATH=./patientsData/patientsdata.db

# PMS_UPLOADS_DIR=./patientsData/xrays



# -----------------------------------------------------------------------------

# Staff email domain & initial admin (created on first run if no staff exist)

# -----------------------------------------------------------------------------

# All staff logins use username + this domain (e.g. admin + @pws.com)

PMS_EMAIL_DOMAIN=@pws.com



# Initial admin account (only when the database has no staff yet)

PMS_ADMIN_USERNAME=admin

PMS_ADMIN_PASSWORD=change-me-in-production

PMS_ADMIN_FULL_NAME=Administrator

# Load sample patients, appointments, and billing on first start (empty DB only)
PMS_SEED_DEMO=0

# Daily auto-backup when server runs (default: enabled). Set hour 0-23 for clinic close time.
# PMS_AUTO_BACKUP=1
# PMS_BACKUP_HOUR=20

# Password for demo staff accounts (dr.amin, sara) — falls back to PMS_ADMIN_PASSWORD
PMS_DEMO_STAFF_PASSWORD=change-me-in-production

